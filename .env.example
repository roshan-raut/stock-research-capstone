# Copy to .env for local runs (never commit the real .env).
# Local dev still resolves secrets via the Databricks SDK (WorkspaceClient),
# so you need `databricks auth login` configured with access to the
# `database` and `massive` secret scopes - these vars just point at table
# names / scopes, not raw credentials.

LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url
MASSIVE_SECRET_SCOPE=massive
MASSIVE_SECRET_KEY=api-key
MASSIVE_API_BASE_URL=https://api.massive.com

WATCHLIST_TABLE_NAME=watchlist
COMPANIES_TABLE_NAME=companies
PRICE_SNAPSHOTS_TABLE_NAME=price_snapshots
NEWS_TABLE_NAME=ticker_news_documents
EMBEDDINGS_TABLE_NAME=ticker_news_embeddings
CHUNK_EMBEDDINGS_TABLE_NAME=ticker_news_chunk_embeddings
RESEARCH_NOTES_TABLE_NAME=research_notes
ANALYSIS_REPORTS_TABLE_NAME=analysis_reports
USER_CHECKPOINTS_TABLE_NAME=user_checkpoints

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NOTABLE_MOVE_THRESHOLD_PCT=3.0

# Flask app only - leave blank to disable the in-app "Ask" chat tab.
AGENT_ENDPOINT_NAME=
